{
  "name": "pi-agentfacade",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yxlimo/agentfacade-extensions.git",
    "directory": "hosts/pi"
  },
  "type": "module",
  "description": "Let pi load its model catalog from an AgentFacade gateway at startup instead of editing models.json by hand",
  "pi": {
    "extensions": ["./index.ts"]
  },
  "files": ["*.ts", "core"],
  "scripts": {
    "test": "node --experimental-strip-types test/check.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
